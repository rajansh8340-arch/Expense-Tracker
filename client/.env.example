# ==============================================================================
# Ledgerly Client - Environment Variables Template
# Copy this file to '.env' or '.env.local' and customize for your environment:
#   cp .env.example .env
# ==============================================================================

# Backend API Base URL
# Local Express Server: http://localhost:5000/api
# Vite Dev Proxy:       /api
# Production Cloud API: https://expense-tracker-server-pink.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# Application Display Title & Branding
VITE_APP_TITLE=Ledgerly — Expense Tracker

# Environment Mode (development | staging | production)
VITE_APP_ENV=development

# Feature Flags
# Set to 'false' if you want to hide the 1-click Demo Login on the Auth screen
VITE_ENABLE_DEMO=true
